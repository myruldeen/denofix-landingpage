---
import '../styles/global.css';
import PostDeviceSteps from '../components/PostDeviceSteps.astro';
import { email, phone, whatsapp, address, addressLine } from '../consts';

const nav = [
  { href: '#services', label: 'Services' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#faq', label: 'FAQ' },
  { href: '#mail-in', label: 'Post-in' },
  { href: '#contact', label: 'Contact' }
];

const services = [
  {
    n: '01',
    title: 'Laptop Repair',
    img: '/images/svc-laptop.jpg',
    body: 'Screen, hinge, keyboard, battery and charging port replacement, plus no-power and no-display faults.',
    tags: 'MacBook · Gaming · Ultrabook · Business'
  },
  {
    n: '02',
    title: 'PC & Desktop Repair',
    img: '/images/svc-desktop.jpg',
    body: 'Part replacement, motherboard-level repair and no-boot troubleshooting for desktops and all-in-ones.',
    tags: 'Custom PC · iMac · AIO · Workstation'
  },
  {
    n: '03',
    title: 'Upgrades & SSD Installs',
    img: '/images/svc-upgrade.jpg',
    body: 'SSD and RAM upgrades, thermal paste, Windows or macOS reinstalls, drivers and a full health check after.',
    tags: 'Same-day on most upgrades'
  },
  {
    n: '04',
    title: 'Data Recovery',
    img: '/images/svc-data.jpg',
    body: 'Sector repair and data recovery from hard disks, SSDs, pendrives and memory cards, including dead/not spinning drives.',
    tags: 'HDD · SSD · USB · Memory card'
  },
  {
    n: '05',
    title: 'Custom PC Builds',
    img: '/images/svc-custom.jpg',
    body: 'Full builds for office, gaming or editing. Part-picked to your budget, assembled, stress-tested and documented.',
    tags: 'Parts sourced and tested'
  },
  {
    n: '06',
    title: 'Office & Small Business',
    img: '/images/svc-office.jpg',
    body: 'Workstation setup, backups, network fixes and an ongoing maintenance plan so your team stops losing hours to broken machines.',
    tags: 'On-site or drop-off'
  }
];

const gallery = [
  { src: '/images/shop-1.jpg', caption: 'Bench diagnostics' },
  { src: '/images/shop-2.jpg', caption: 'Component-level soldering' },
  { src: '/images/shop-3.jpg', caption: 'Disassembly & part swaps' },
  { src: '/images/shop-4.jpg', caption: 'Motherboard repair' }
];

const plans = [
  {
    name: 'Diagnostic & Software',
    price: 'from RM 80',
    best: 'Slow, infected or broken software',
    points: [
      'Full diagnostic before quoting',
      'Virus and malware removal',
      'OS reinstall and driver setup',
      'Tune-up and health check report'
    ],
    featured: false
  },
  {
    name: 'Parts & Replacement',
    price: 'quoted per model',
    best: 'Screens, batteries, keyboards, hinges',
    points: [
      'Fixed labour price, parts at cost',
      'Compatible parts sourced for you',
      'Original or premium alternatives',
      'Warranty on parts and workmanship'
    ],
    featured: true
  },
  {
    name: 'Board-Level Repair',
    price: 'from RM 200',
    best: 'No power, shorts, dead machines',
    points: [
      'Component-level troubleshooting',
      'Short circuits and power rails',
      'BGA and chip replacement',
      'Data preserved where possible'
    ],
    featured: false
  }
];

const faqs = [
  {
    q: 'How much does a repair cost?',
    a: 'Diagnostics are free. Once we know the cause you get a fixed price in writing before anything starts. Screen and battery jobs depend on the model, software work starts from RM 80, and board-level repair starts from RM 200.'
  },
  {
    q: 'How long will it take?',
    a: 'Most software jobs and common part replacements are done the same day or next day. Board-level repairs and parts that have to be ordered usually take a few days. You get a realistic timeline with the quote, and we message you if anything changes.'
  },
  {
    q: 'Do you handle data privacy?',
    a: 'Yes. Your files stay on your machine unless recovery work requires otherwise, and we do not browse personal data. If a drive is failing, recovering your data comes before anything else.'
  },
  {
    q: 'Can I post my device to you?',
    a: `Yes. Pack the device well, include a note with your contact details and the fault, and post it to our mail-in address: ${addressLine}. We quote before repairing and post it back once it is tested.`
  },
  {
    q: 'What warranty do I get?',
    a: 'Every repair carries a warranty on the workmanship and on the fitted parts. If the same fault returns within the warranty period, we fix it again at no charge.'
  },
  {
    q: 'What if the machine is not worth fixing?',
    a: 'We will say so. You get the diagnostic, an honest cost-versus-value answer, and options: repair, upgrade, or data recovery only. No pressure to go ahead.'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Denofix — PC & Laptop Repair Specialist</title>
    <meta
      name="description"
      content="Denofix repairs, upgrades and builds PCs and laptops. Free diagnostic, fixed quote before any work, warranty on every repair. Mail-in and walk-in."
    />
    <link rel="canonical" href={new URL('/', Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Denofix" />
    <meta property="og:title" content="Denofix — PC & Laptop Repair Specialist" />
    <meta
      property="og:description"
      content="Free diagnostic, fixed quote before any work, warranty 1 month on every repair. Laptop and desktop repair, data recovery and custom PC builds in Malaysia."
    />
    <meta property="og:url" content={new URL('/', Astro.site).href} />
    <meta property="og:image" content={new URL('/images/og.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Denofix — PC & Laptop Repair Specialist" />
    <meta
      name="twitter:description"
      content="Free diagnostic, fixed quote before any work, warranty 1 month on every repair. Laptop and desktop repair, data recovery and custom PC builds in Malaysia."
    />
    <meta name="twitter:image" content={new URL('/images/og.png', Astro.site).href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2563eb" />
  </head>
  <body>    <header class="sticky top-0 z-50 border-b border-line bg-white/90 backdrop-blur-[12px]">
      <div class="wrap flex h-[72px] items-center gap-7">
        <a class="inline-flex items-center gap-2.5 text-[1.05rem] font-bold tracking-[-0.01em] text-ink" href="#top" aria-label="Denofix home">
          <img class="block h-9 w-9 object-contain" src="/images/logo-mark-128.png" alt="" width="128" height="128" />
          Denofix
        </a>
        <nav class="ml-auto hidden gap-[26px] text-[15px] text-muted min-[900px]:flex" aria-label="Main">
          {nav.map((item) => (
            <a class="transition-colors hover:text-ink" href={item.href}>{item.label}</a>
          ))}
        </nav>
        <a class="inline-flex items-center gap-2 border border-transparent bg-brand px-5 py-2.5 text-[15px] font-semibold text-white transition duration-150 hover:-translate-y-0.5 hover:bg-brand-hover max-[900px]:ml-auto" href="#contact">Get a quote</a>
      </div>
    </header>

    <main id="top">
      <section class="hero-bg py-24 max-md:py-[68px]">
        <div class="wrap grid items-center gap-14 max-[900px]:grid-cols-1 max-[900px]:gap-10 lg:grid-cols-[1.3fr_1fr]">
          <div>
            <span class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">PC & laptop specialists · Malaysia</span>
            <h1 class="text-[clamp(2.4rem,6vw,4rem)] font-bold">Broken laptop or PC?<br />We fix it properly — quote first.</h1>
            <p class="mt-6 max-w-[640px] text-[clamp(1.05rem,2vw,1.2rem)] text-muted">
              Denofix repairs, upgrades and builds computers. Free diagnostic, a fixed
              price in writing before any work starts, and nothing touched on your
              machine without your approval.
            </p>
            <div class="mt-8 flex flex-wrap gap-3.5">
              <a class="inline-flex items-center gap-2 border border-transparent bg-brand px-6 py-[13px] text-[15px] font-semibold text-white transition duration-150 hover:-translate-y-0.5 hover:bg-brand-hover" href="#contact">Get a free quote →</a>
              <a class="inline-flex items-center gap-2 border border-line px-6 py-[13px] text-[15px] font-semibold text-ink transition duration-150 hover:-translate-y-0.5 hover:border-muted" href="#pricing">See pricing</a>
            </div>
            <ul class="mt-[34px] flex list-none flex-wrap gap-x-[26px] gap-y-3 text-[14.5px] text-muted">
              <li class="relative pl-5 before:absolute before:left-0 before:font-bold before:text-ok before:content-['✓']">Free diagnostic</li>
              <li class="relative pl-5 before:absolute before:left-0 before:font-bold before:text-ok before:content-['✓']">Fixed quote, no hourly billing</li>
              <li class="relative pl-5 before:absolute before:left-0 before:font-bold before:text-ok before:content-['✓']">Warranty 1 month on every repair</li>
            </ul>
          </div>
          <figure class="relative border border-line bg-white shadow-[0_18px_44px_rgba(16,24,40,0.12)]">
            <img
              class="block h-[min(560px,62vh)] w-full object-cover max-[900px]:h-80"
              src="/images/hero.jpg"
              alt="Technician repairing a laptop at the Denofix workbench"
              width="900"
              height="1125"
            />
            <figcaption class="border-t border-line px-[18px] py-[13px] text-sm text-muted">Repairs, upgrades and builds — all done in-house.</figcaption>
          </figure>
        </div>
        <div class="wrap">
          <div class="mt-14 border border-line bg-white shadow-[0_1px_2px_rgba(16,24,40,0.05)]">
            <div class="flex flex-wrap justify-between gap-2 border-b border-line px-[22px] py-4 text-[15px]">
              <strong class="font-semibold">Common faults we fix</strong>
              <span class="text-sm text-muted">Walk in, message us, or post the device.</span>
            </div>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))]">
              <div class="flex items-center gap-3 border-r border-dashed border-line px-[22px] py-[15px] text-[14.5px] text-ink max-[900px]:border-r-0 max-[900px]:border-b">
                <span class="h-2 w-2 flex-none bg-brand"></span> No power / no display
              </div>
              <div class="flex items-center gap-3 border-r border-dashed border-line px-[22px] py-[15px] text-[14.5px] text-ink max-[900px]:border-r-0 max-[900px]:border-b">
                <span class="h-2 w-2 flex-none bg-brand"></span> Cracked screen or dead battery
              </div>
              <div class="flex items-center gap-3 border-r border-dashed border-line px-[22px] py-[15px] text-[14.5px] text-ink max-[900px]:border-r-0 max-[900px]:border-b">
                <span class="h-2 w-2 flex-none bg-brand"></span> Slow, hot or crashing
              </div>
              <div class="flex items-center gap-3 border-r border-dashed border-line px-[22px] py-[15px] text-[14.5px] text-ink max-[900px]:border-r-0 max-[900px]:border-b">
                <span class="h-2 w-2 flex-none bg-brand"></span> HDD not spinning, missing files
              </div>
              <div class="flex items-center gap-3 border-r border-dashed border-line px-[22px] py-[15px] text-[14.5px] text-ink max-[900px]:border-r-0 max-[900px]:border-b">
                <span class="h-2 w-2 flex-none bg-brand"></span> Water damage &amp; shorts
              </div>
              <div class="flex items-center gap-3 border-r border-dashed border-line px-[22px] py-[15px] text-[14.5px] text-ink max-[900px]:border-r-0 max-[900px]:border-b">
                <span class="h-2 w-2 flex-none bg-brand"></span> SSD or RAM upgrade
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="border-t border-line bg-soft py-24 max-md:py-[68px]" id="services">
        <div class="wrap">
          <div class="mb-14 max-w-[720px]">
            <span class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">Services</span>
            <h2 class="mb-[18px] text-[clamp(1.9rem,4vw,2.75rem)] font-bold">Everything that keeps your machine running</h2>
            <p class="max-w-[640px] text-[clamp(1.05rem,2vw,1.2rem)] text-muted">
              From a five-minute SSD swap to component-level motherboard work — one
              specialist, no queue of subcontractors.
            </p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {services.map((s) => (
              <article class="overflow-hidden border border-line bg-white shadow-[0_1px_2px_rgba(16,24,40,0.05)] transition duration-200 hover:-translate-y-[3px] hover:shadow-[0_14px_30px_rgba(16,24,40,0.12)]">
                <img class="block aspect-[16/10] w-full border-b border-line object-cover" src={s.img} alt={s.title} width="800" height="500" loading="lazy" />
                <div class="px-[26px] pb-7 pt-6">
                  <span class="mb-3.5 block text-[13px] font-bold tracking-[0.08em] text-brand">{s.n}</span>
                  <h3 class="mb-2.5 text-[1.15rem] font-bold">{s.title}</h3>
                  <p class="text-[15px] text-muted">{s.body}</p>
                  <p class="mt-4 text-[13px] tracking-[0.02em] text-brand">{s.tags}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <PostDeviceSteps />

      <section class="border-t border-line bg-soft py-24 max-md:py-[68px]" id="workshop">
        <div class="wrap">
          <div class="mb-14 max-w-[720px]">
            <span class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">Inside the workshop</span>
            <h2 class="mb-[18px] text-[clamp(1.9rem,4vw,2.75rem)] font-bold">Where your machine gets fixed</h2>
            <p class="max-w-[640px] text-[clamp(1.05rem,2vw,1.2rem)] text-muted">
              Real benches, real tools, no send-it-away middleman. Every job stays
              with the same specialist from diagnostic to final test.
            </p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {gallery.map((g) => (
              <figure class="border border-line bg-white shadow-[0_1px_2px_rgba(16,24,40,0.05)]">
                <img class="block aspect-[4/3] w-full border-b border-line object-cover" src={g.src} alt={g.caption} width="700" height="525" loading="lazy" />
                <figcaption class="px-4 py-3 text-sm text-muted">{g.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="border-t border-line py-24 max-md:py-[68px]" id="pricing">
        <div class="wrap">
          <div class="mb-14 max-w-[720px]">
            <span class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">Pricing</span>
            <h2 class="mb-[18px] text-[clamp(1.9rem,4vw,2.75rem)] font-bold">Fixed prices, agreed before we start</h2>
            <p class="max-w-[640px] text-[clamp(1.05rem,2vw,1.2rem)] text-muted">
              Every job is quoted up front against a written scope. If the scope does
              not change, the price does not either.
            </p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {plans.map((p) => (
              <article
                class:list={[
                  'relative flex flex-col border bg-white p-7 shadow-[0_1px_2px_rgba(16,24,40,0.05)]',
                  p.featured ? 'border-brand shadow-[0_0_0_1px_#2563eb]' : 'border-line'
                ]}
              >
                {p.featured && (
                  <span class="absolute -top-3 left-6 bg-brand px-3 py-[3px] text-xs font-semibold text-white">Most common</span>
                )}
                <h3 class="mb-2.5 text-[1.15rem] font-bold">{p.name}</h3>
                <p class="text-sm text-muted">{p.best}</p>
                <p class="mb-1 mt-[18px] text-[1.7rem] font-bold tracking-[-0.02em]">{p.price}</p>
                <ul class="mt-5 grid list-none gap-3">
                  {p.points.map((pt) => (
                    <li class="relative pl-7 text-[15px] text-muted before:absolute before:left-0 before:font-bold before:text-ok before:content-['✓']">{pt}</li>
                  ))}
                </ul>
                <a
                  class:list={[
                    'mt-[26px] inline-flex items-center justify-center gap-2 border px-6 py-[13px] text-[15px] font-semibold transition duration-150 hover:-translate-y-0.5',
                    p.featured
                      ? 'border-transparent bg-brand text-white hover:bg-brand-hover'
                      : 'border-line text-ink hover:border-muted'
                  ]}
                  href="#contact"
                >
                  Request a quote
                </a>
              </article>
            ))}
          </div>
          <p class="mt-[30px] text-[14.5px] text-muted">
            Parts are charged at cost with fixed labour. You approve the total before
            any part is ordered.
          </p>
        </div>
      </section>

      <section class="border-t border-line bg-soft py-24 max-md:py-[68px]" id="faq">
        <div class="wrap">
          <div class="mb-14 max-w-[720px]">
            <span class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">FAQ</span>
            <h2 class="mb-[18px] text-[clamp(1.9rem,4vw,2.75rem)] font-bold">Questions we get asked</h2>
          </div>
          <div class="grid max-w-[820px] gap-3">
            {faqs.map((f) => (
              <details class="border border-line bg-white px-6 py-1 open:bg-white">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-[18px] font-semibold [&::-webkit-details-marker]:hidden after:content-['+'] after:text-[1.3rem] after:leading-none after:text-brand open:after:content-['–']">
                  {f.q}
                </summary>
                <p class="pb-5 text-[15.5px] text-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="border-t border-line py-24 max-md:py-[68px]" id="contact">
        <div class="wrap grid items-start gap-12 max-[900px]:grid-cols-1 max-[900px]:gap-10 lg:grid-cols-2">
          <div>
            <span class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">Get started</span>
            <h2 class="mb-[18px] text-[clamp(1.9rem,4vw,2.75rem)] font-bold">Tell us what is broken</h2>
            <p class="max-w-[640px] text-[clamp(1.05rem,2vw,1.2rem)] text-muted">
              Send the model and the fault, or a photo of any damage. You get a free
              diagnostic and a fixed quote before any work begins.
            </p>
            <ul class="mt-[34px] grid list-none gap-[18px]">
              <li>
                <span class="mb-[3px] block text-[13px] uppercase tracking-[0.1em] text-muted">Email</span>
                <a class="font-semibold text-brand" href={`mailto:${email}`}>{email}</a>
              </li>
              <li>
                <span class="mb-[3px] block text-[13px] uppercase tracking-[0.1em] text-muted">WhatsApp</span>
                <a class="font-semibold text-brand" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">{phone}</a>
              </li>
              <li>
                <span class="mb-[3px] block text-[13px] uppercase tracking-[0.1em] text-muted">Service</span>
                <span>Walk-in drop-off · Mail-in across Malaysia · On-site for offices</span>
              </li>
              <li>
                <span class="mb-[3px] block text-[13px] uppercase tracking-[0.1em] text-muted">Mail-in address</span>
                <address class="text-[15.5px] not-italic leading-[1.6] text-ink">
                  {address.line1}<br />
                  {address.line2}<br />
                  {address.line3}
                </address>
              </li>
            </ul>
          </div>
          <form class="grid gap-4 border border-line bg-white p-7 shadow-[0_1px_2px_rgba(16,24,40,0.05)]" action={`mailto:${email}`} method="post" enctype="text/plain">
            <label class="grid gap-[7px] text-sm text-muted">
              Your name
              <input class="rounded-none border border-line bg-white px-3.5 py-3 text-[15px] text-ink outline-none focus:border-brand" type="text" name="name" placeholder="Name" required />
            </label>
            <label class="grid gap-[7px] text-sm text-muted">
              Email or phone
              <input class="rounded-none border border-line bg-white px-3.5 py-3 text-[15px] text-ink outline-none focus:border-brand" type="text" name="contact" placeholder="How we reach you" required />
            </label>
            <label class="grid gap-[7px] text-sm text-muted">
              Device &amp; problem
              <textarea class="resize-y rounded-none border border-line bg-white px-3.5 py-3 text-[15px] text-ink outline-none focus:border-brand" name="fault" rows="5" placeholder="e.g. Lenovo Legion — no power, LED blinks twice" required></textarea>
            </label>
            <button class="inline-flex items-center justify-center gap-2 border border-transparent bg-brand px-6 py-[13px] text-[15px] font-semibold text-white transition duration-150 hover:-translate-y-0.5 hover:bg-brand-hover" type="submit">Send enquiry</button>
            <p class="text-center text-[13.5px] text-muted">We reply within one working day. No spam, ever.</p>
          </form>
        </div>
      </section>
    </main>

    <footer class="border-t border-line bg-soft pt-16">
      <div class="wrap grid gap-10 pb-12 md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
        <div>
          <a class="inline-flex items-center gap-2.5 text-[1.05rem] font-bold tracking-[-0.01em] text-ink" href="#top">
            <img class="block h-9 w-9 object-contain" src="/images/logo-mark-128.png" alt="" width="128" height="128" />
            Denofix
          </a>
          <p class="mt-4 max-w-[320px] text-[14.5px] text-muted">PC and laptop repairs with a fixed quote before any work. Malaysia.</p>
        </div>
        <nav class="grid content-start gap-2.5" aria-label="Services">
          <h4 class="mb-1.5 text-[13px] font-bold uppercase tracking-[0.1em] text-muted">Services</h4>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#services">Laptop repair</a>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#services">PC &amp; desktop repair</a>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#services">Data recovery</a>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#services">Custom PC builds</a>
        </nav>
        <nav class="grid content-start gap-2.5" aria-label="Company">
          <h4 class="mb-1.5 text-[13px] font-bold uppercase tracking-[0.1em] text-muted">Company</h4>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#mail-in">Post-in repair</a>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#pricing">Pricing</a>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#faq">FAQ</a>
          <a class="text-[15px] text-ink transition-colors hover:text-brand" href="#contact">Contact</a>
        </nav>
