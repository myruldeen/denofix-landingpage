---
import '../styles/global.css';
import { phone, websiteLabel, companyName, ssm, trademark } from '../consts';

const conditions = ['Cable / Charger', 'LCD', 'Casing', 'Battery', 'Screw', 'Other'];

const terms = [
  'We charge no fee for device checking/diagnose process and it may take around 1-7 working days depending on queue.',
  'After checking process, we will provide a price quotation to fix your device issue. Once payment have been made, we will proceed to order the sparepart and this may take another 1-21 working days for it to arrive to our shop depending on the supplier location and courier delivery process.',
  'After the repair process, we will do a 24 hour test to ensure the device is working fine, then we will contact you by whatsapp for collection.',
  'During collection, please provide us with this repair form as it is our way of telling you are the owner of this device. If your receipt is loss, please provide us with the receipt number as well as phone number for verification.',
  'We reserve the right to dispose of any device that remains uncollected or receives no response from the customer within 30 days after we have provided an update regarding its inspection, diagnosis, or repair status. Such devices will be disposed of without any further notice, in accordance with our policy.'
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>Repair Form — DenoFix</title>
    <meta name="description" content="DenoFix repair form for mail-in laptop and PC repairs. Print or save as PDF, fill it in and pack it with your device." />
    <link rel="canonical" href={new URL('/repair-form', Astro.site).href} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="form-bg">
      <div class="form-bar no-print">
        <button id="print-form" type="button">Print / Save as PDF</button>
      </div>

      <section class="sheet">
        <header class="sheet-head">
          <div>
            <p class="sheet-brand">{companyName}</p>
            <h1>Repair Form</h1>
          </div>
          <label class="receipt">
            <span>Receipt No</span>
            <input type="text" name="receipt" />
          </label>
        </header>

        <div class="fields">
          <label class="field">
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" />
          </label>
          <label class="field">
            <span>Phone Number</span>
            <input type="text" name="phone" autocomplete="tel" />
          </label>
          <label class="field">
            <span>Device Model</span>
            <input type="text" name="model" />
          </label>
          <label class="field field-top">
            <span>Device Issue</span>
            <textarea name="issue" rows="3"></textarea>
          </label>
          <label class="field">
            <span>Device Password</span>
            <input type="text" name="password" />
          </label>
          <div class="field field-top">
            <span>Device Condition</span>
            <div class="check-grid">
              {conditions.map((c) => (
                <label class="check">
                  <input type="checkbox" name="condition" value={c} />
                  {c}
                </label>
              ))}
            </div>
          </div>
        </div>

        <section class="terms">
          <h2>Terms and Condition</h2>
          <ol>
            {terms.map((t) => <li>{t}</li>)}
          </ol>
          <label class="sign">
            <span>Please sign here if you agree with our terms and condition :)</span>
            <span class="sign-line"></span>
          </label>
        </section>

        <footer class="sheet-foot">
          <p class="foot-contacts">WhatsApp: {phone} &nbsp;·&nbsp; Call: {phone} &nbsp;·&nbsp; Web: {websiteLabel}</p>
          <p class="foot-company">{companyName} &nbsp;·&nbsp; SSM No: {ssm}</p>
          <p class="foot-trademark">“{trademark}”</p>
        </footer>
      </section>
    </main>

    <script src="/print.js" is:inline defer></script>

    <style>
      .form-bg {
        min-height: 100vh;
        background: #eef1f5;
        padding: 28px 16px 56px;
      }

      .form-bar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        max-width: 820px;
        margin: 0 auto 18px;
      }

      .form-bar button {
        border: 1px solid transparent;
        background: var(--color-brand);
        color: #fff;
        padding: 12px 22px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
      }

      .form-bar button:hover {
        background: var(--color-brand-hover);
      }

      .sheet {
        max-width: 820px;
        margin: 0 auto;
        padding: 42px 46px;
        background: #fff;
        color: var(--color-ink);
        border: 3px solid var(--color-ink);
        box-shadow: 0 12px 34px rgba(16, 24, 40, 0.12);
      }

      .sheet-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 2px solid var(--color-ink);
        padding-bottom: 16px;
      }

      .sheet-brand {
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--color-brand);
      }

      .sheet-head h1 {
        font-size: 1.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .receipt {
        text-align: right;
      }

      .receipt span {
        display: block;
        margin-bottom: 6px;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
      }

      .receipt input {
        width: 190px;
        text-align: right;
        border: 2px solid var(--color-ink);
        background: #fff;
        padding: 10px 12px;
        font: inherit;
        font-size: 15px;
        color: var(--color-ink);
        border-radius: 0;
      }

      .fields {
        display: grid;
        gap: 16px;
        margin-top: 26px;
      }

      .field {
        display: grid;
        grid-template-columns: 160px 1fr;
        align-items: center;
        gap: 14px;
      }

      .field.field-top {
        align-items: start;
      }

      .field > span {
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-muted);
      }

      .field.field-top > span {
        padding-top: 11px;
      }

      .field input[type='text'],
      .field textarea {
        width: 100%;
        border: 2px solid var(--color-ink);
        background: #fff;
        padding: 10px 12px;
        font: inherit;
        font-size: 15px;
        color: var(--color-ink);
        border-radius: 0;
      }

      .field input[type='text']:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--color-brand);
      }

      .field textarea {
        min-height: 76px;
        resize: vertical;
      }

      .check-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 26px;
        border: 2px solid var(--color-ink);
        padding: 14px 16px;
      }

      .check {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 14px;
      }

      .check input {
        width: 16px;
        height: 16px;
        accent-color: var(--color-brand);
      }

      .terms {
        margin-top: 30px;
        border-top: 1px solid var(--color-line);
        padding-top: 22px;
      }

      .terms h2 {
        margin-bottom: 14px;
        font-size: 13px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .terms ol {
        display: grid;
        gap: 10px;
        padding-left: 20px;
        list-style: decimal;
      }

      .terms li {
        font-size: 13px;
        line-height: 1.6;
        color: #3a4351;
      }

      .sign {
        display: block;
        margin-top: 26px;
      }

      .sign > span:first-child {
        display: block;
        margin-bottom: 26px;
        font-size: 13px;
        color: var(--color-muted);
      }

      .sign-line {
        display: block;
        width: 280px;
        border-top: 1px solid var(--color-ink);
      }

      .sheet-foot {
        margin-top: 30px;
        border-top: 1px solid var(--color-line);
        padding-top: 16px;
        text-align: center;
      }

      .foot-contacts {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--color-ink);
      }

      .foot-company {
        margin-top: 6px;
        font-size: 13px;
        color: var(--color-ink);
      }

      .foot-trademark {
        margin-top: 2px;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-muted);
      }

      @media (max-width: 560px) {
        .field {
          grid-template-columns: 1fr;
          gap: 7px;
        }

        .field.field-top > span {
          padding-top: 0;
        }
      }

      @media print {
        @page {
          size: A4;
          margin: 0;
        }

        .no-print {
          display: none !important;
        }

        .form-bg {
          min-height: 0;
          background: #fff;
          padding: 0;
        }

        .sheet {
          max-width: none;
          margin: 8mm;
          padding: 0;
          box-shadow: none;
        }

        .sheet-head {
          padding-bottom: 10px;
        }

        .fields {
          gap: 11px;
          margin-top: 16px;
        }

        .terms {
          margin-top: 18px;
          padding-top: 14px;
        }

        .terms li {
          font-size: 11px;
          line-height: 1.5;
        }

        .sign {
          margin-top: 16px;
        }

        .sign > span:first-child {
          margin-bottom: 16px;
        }

        .sheet-foot {
          margin-top: 16px;
          padding-top: 12px;
        }
      }
    </style>
  </body>
</html>
