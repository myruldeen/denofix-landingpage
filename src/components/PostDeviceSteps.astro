---
import { address } from '../consts';

const { showDownload = true } = Astro.props;

const steps = [
  {
    title: 'Download our form',
    body: 'Click the button to download the DenoFix repair form and print a copy.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>'
  },
  {
    title: 'Fill in the details',
    body: 'Complete every field except the receipt number or anything that is not related to your device.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>'
  },
  {
    title: 'Pack it with the device',
    body: 'Attach the form to the device, then wrap it in bubble wrap and a hard box so it arrives safely.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m21 8-9-5-9 5v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg>'
  },
  {
    title: 'Courier it to us',
    body: 'Drop the parcel at your nearest courier and send it to the address below.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>'
  }
];
---

<section class="border-t border-line py-24 max-md:py-[68px]" id="mail-in">
  <div class="wrap">
    <div class="mb-14 max-w-[720px]">
      <span class="mb-4 inline-block text-[13px] font-semibold uppercase tracking-[0.12em] text-brand">Post-in repair</span>
      <h2 class="mb-[18px] text-[clamp(1.9rem,4vw,2.75rem)] font-bold">Post your device to us</h2>
      <p class="max-w-[640px] text-[clamp(1.05rem,2vw,1.2rem)] text-muted">
        Not local to Klang? Send the device in. Follow the four steps below and we
        handle the rest — free diagnostic and a fixed quote before anything is touched.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <article class="flex flex-col border border-line bg-white p-7 shadow-[0_1px_2px_rgba(16,24,40,0.05)]">
          <div class="mb-5 flex h-12 w-12 items-center justify-center border border-line bg-soft text-brand">
            <span class="block h-6 w-6" set:html={s.icon} />
          </div>
          <span class="mb-2.5 block text-[13px] font-bold tracking-[0.08em] text-muted">Step {i + 1}</span>
          <h3 class="mb-2.5 text-[1.15rem] font-bold">{s.title}</h3>
          <p class="text-[15px] text-muted">{s.body}</p>

          {i === 0 && showDownload && (
            <a
              class="mt-5 inline-flex items-center justify-center gap-2 border border-transparent bg-brand px-5 py-3 text-[14px] font-semibold text-white transition duration-150 hover:-translate-y-0.5 hover:bg-brand-hover"
              href="/repair-form"
              data-repair-form-popup
              target="_blank"
              rel="noopener"
            >
              Download repair form
            </a>
          )}

          {i === 3 && (
            <address class="mt-auto border-t border-line pt-4 text-[14.5px] not-italic leading-[1.6] text-ink">
              <span class="mb-1.5 block text-[12px] uppercase tracking-[0.1em] text-muted">Send your parcel to</span>
              {address.line1}<br />
              {address.line2}<br />
              {address.line3}
            </address>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script src="/repair-form-popup.js" is:inline defer></script>
